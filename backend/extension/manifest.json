{
  "manifest_version": 3,
  "name": "Vortex Cookie Sync",
  "version": "1.0.0",
  "description": "Auto-syncs YouTube cookies to your Vortex server. Install once, works forever.",
  "permissions": ["cookies", "storage", "alarms"],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Vortex Cookie Sync"
  }
}
